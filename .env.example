# 后台模型渠道配置（抽取、摘要等后台任务）
DRAMATICER_BG_BASE_URL=
DRAMATICER_BG_API_KEY=
DRAMATICER_BG_MODEL=
# 可选：思考档位（off/minimal/low/medium/high/xhigh/max；留空就不发这个参数）
DRAMATICER_BG_REASONING_EFFORT=

# 后台保底渠道（建议填另一家供应商）：主后台渠道额度耗尽或被停用时，结算、记忆与
# 导演改用它，不会停摆。在 channels.yaml 里由 background 的 fallback 指向 bg-fallback。
DRAMATICER_BG2_BASE_URL=
DRAMATICER_BG2_API_KEY=
DRAMATICER_BG2_MODEL=

# 正文主模型渠道配置（M1 单轮生成）
DRAMATICER_MAIN_BASE_URL=
DRAMATICER_MAIN_API_KEY=
DRAMATICER_MAIN_MODEL=

# 向量嵌入渠道配置（M2 检索与嵌入）
SILICONFLOW_API_KEY=
# NovelAI 生图的持久令牌（pst- 开头），见 images.example.yaml
NOVELAI_API_KEY=

# SillyTavern 本地数据目录根路径（快照只读源）
DRAMATICER_ST_ROOT=

# 渠道的限速、超时、重试次数与优先级在 data/channels.yaml 里配置；
# 复制仓库根目录的 channels.example.yaml 后按需修改。

# Vertex AI（api: google-vertex）。服务账号 JSON 放在仓库外，填它的绝对路径；
# 项目与区域从服务账号所属项目读取，区域 global 对应全球端点。
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
