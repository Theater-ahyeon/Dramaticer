{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"composite": false,
		"declaration": false,
		"declarationMap": false,
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"noEmit": true,
		"sourceMap": false,
		"types": ["vite/client"]
	},
	"include": ["src/**/*", "test/**/*", "vite.config.ts"]
}
