{
	"name": "@dramaticer/st-compat",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"dramaticer": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@dramaticer/core": "workspace:*",
		"better-sqlite3": "^13.0.3",
		"droll": "^0.2.1",
		"ejs": "^3.1.10",
		"lodash": "^4.18.1",
		"moment": "^2.31.0",
		"png-chunk-text": "^1.0.0",
		"png-chunks-extract": "^1.0.0",
		"seedrandom": "^3.0.5",
		"yaml": "^2.9.1"
	},
	"scripts": {
		"build": "tsc",
		"chat": "tsc -b && node dist/cli.js chat",
		"evalset": "tsc -b && node dist/evalset/cli.js",
		"evalset:events": "tsc -b && node dist/evalset/event-cli.js",
		"events-backfill": "tsc -b && node dist/evalset/events-cli.js",
		"gap-pass-compare": "tsc -b && node dist/evalset/gap-pass-compare-cli.js",
		"world-model-compare": "tsc -b && node dist/evalset/world-model-compare-cli.js",
		"director-organization-compare": "tsc -b && node dist/evalset/director-organization-compare-cli.js",
		"r6-compare": "tsc -b && node dist/evalset/r6-compare-cli.js",
		"r6-b1": "tsc -b && node dist/evalset/r6-b1-cli.js",
		"r6-deep": "tsc -b && node dist/evalset/r6-deep-cli.js",
		"r6-preference": "tsc -b && node dist/evalset/r6-preference-cli.js",
		"r6-instrument": "tsc -b && node dist/evalset/r6-instrument-cli.js",
		"r6-replay": "tsc -b && node dist/evalset/r6-replay-cli.js",
		"scene-log-compare": "tsc -b && node dist/evalset/scene-log-compare-cli.js",
		"memory-eval": "tsc -b && node dist/evalset/memory-cli.js",
		"playtest": "tsc -b && node dist/evalset/playtest-cli.js",
		"deep-eval": "tsc -b && node dist/evalset/deep-eval-cli.js",
		"pairwise": "tsc -b && node dist/evalset/pairwise-cli.js",
		"replay-eval": "tsc -b && node dist/evalset/historical-replay-cli.js",
		"scoreboard": "tsc -b && node dist/evalset/scoreboard-cli.js",
		"preferences": "tsc -b && node dist/preferences/cli.js",
		"opening-eval": "tsc -b && node dist/evalset/opening-eval-cli.js",
		"benchmark": "tsc -b && node dist/evalset/benchmark-cli.js",
		"forgetting-report": "tsc -b && node dist/evalset/forgetting-report-cli.js",
		"probe-report": "tsc -b && node dist/evalset/probe-report-cli.js",
		"director-eval": "tsc -b && node dist/evalset/director-cli.js",
		"report": "tsc -b && node dist/health/cli.js",
		"st-bench": "tsc -b && node dist/st-bench/cli.js",
		"reference": "tsc -b && node dist/reference/cli.js",
		"reference:cosine": "tsc -b && node dist/reference/cli.js --cosine"
	},
	"devDependencies": {
		"@playwright/test": "1.63.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/ejs": "^3.1.5",
		"@types/lodash": "^4.17.27",
		"@types/seedrandom": "^3.0.8"
	}
}
