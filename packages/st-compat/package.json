{
	"name": "@dramaticer/st-compat",
	"version": "0.1.0",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"dramaticer": "./dist/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"dependencies": {
		"@dramaticer/core": "workspace:*",
		"better-sqlite3": "^13.0.3",
		"png-chunk-text": "^1.0.0",
		"png-chunks-extract": "^1.0.0"
	},
	"scripts": {
		"build": "tsc",
		"chat": "tsc -b && node dist/cli.js chat",
		"evalset": "tsc -b && node dist/evalset/cli.js",
		"evalset:events": "tsc -b && node dist/evalset/event-cli.js",
		"report": "tsc -b && node dist/health/cli.js"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^9.6.0"
	}
}
