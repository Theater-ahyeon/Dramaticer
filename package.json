{
	"name": "dramaticer-monorepo",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"invariants": "node scripts/check-invariants.mjs",
		"typecheck": "tsc -b",
		"lint": "biome check .",
		"test": "vitest run",
		"snapshot": "node scripts/snapshot-private-data.mjs",
		"probe": "pnpm --filter @dramaticer/core probe",
		"dramaticer": "pnpm --filter @dramaticer/core build && node packages/core/dist/cli/index.js",
		"check": "pnpm run invariants && pnpm run typecheck && pnpm run lint && pnpm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@types/node": "^24.13.0",
		"png-chunk-text": "^1.0.0",
		"png-chunks-extract": "^1.0.0",
		"typescript": "^5.8.2",
		"vitest": "^3.0.7"
	}
}
