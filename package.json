{
	"name": "dramaticer-monorepo",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19"
	},
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"invariants": "node scripts/check-invariants.mjs",
		"typecheck": "tsc -b && pnpm --filter @dramaticer/web typecheck",
		"lint": "biome check .",
		"test": "vitest run --project unit",
		"test:eval": "vitest run --project eval",
		"test:all": "vitest run",
		"build": "tsc -b && pnpm --filter @dramaticer/web build",
		"snapshot": "node scripts/snapshot-private-data.mjs",
		"probe": "pnpm --filter @dramaticer/st-compat build && node packages/st-compat/dist/cli.js probe",
		"chat": "pnpm --filter @dramaticer/st-compat build && node packages/st-compat/dist/cli.js chat",
		"work": "pnpm --filter @dramaticer/st-compat build && node packages/st-compat/dist/cli.js work",
		"serve": "pnpm --filter @dramaticer/server build && node packages/server/dist/cli.js",
		"e2e": "pnpm --filter @dramaticer/web e2e",
		"playtest": "pnpm --filter @dramaticer/web playtest",
		"dramaticer": "pnpm --filter @dramaticer/st-compat build && node packages/st-compat/dist/cli.js",
		"package:release": "node scripts/package-release.mjs",
		"check": "pnpm run invariants && pnpm run typecheck && pnpm run lint && pnpm run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@earendil-works/pi-agent-core": "1.5.0",
		"@earendil-works/pi-ai": "1.5.0",
		"@types/node": "^24.13.0",
		"png-chunk-text": "^1.0.0",
		"png-chunks-extract": "^1.0.0",
		"typescript": "^5.8.2",
		"vitest": "^3.0.7"
	}
}
